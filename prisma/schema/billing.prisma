model BillingAccount {
  orgId                String    @id @db.Uuid
  org                  Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique // the one subscription this org follows; others' events are ignored (FR-04)
  plan                 String?
  status               String? // mirrors Stripe subscription.status
  currentPeriodEnd     DateTime? @db.Timestamptz(6)
  stripeEventAt        DateTime? @db.Timestamptz(6) // created time of the last event applied; older ones are skipped
  updatedAt            DateTime  @updatedAt @db.Timestamptz(6)
}

model StripeEvent {
  id          String    @id // evt_…
  type        String
  payload     Json
  receivedAt  DateTime  @default(now()) @db.Timestamptz(6)
  processedAt DateTime? @db.Timestamptz(6) // NULL ⇒ re-apply on redelivery (INV-12)
  error       String?
}
