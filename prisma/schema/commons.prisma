// Commons' own tables (clone-owned; Phase 2, task 2.1). Shape: D-7 (epoch seconds inside the engines; here
// TIMESTAMPTZ, converted at the boundary), D-12/D-29 (the author's fixed +1 is a Vote row; one current Vote row
// per voter and node, enforced by the unique index, plus an append-only VoteEvent log), D-13 (removed nodes keep
// their rows and their subtree), D-26/D-28/D-34 (materialized path, 6-char base-36 segments, COLLATE "C" path),
// D-30 (replies under a removed node refused in the writer, not here), D-31 (BrigadeSignal, recorded never acted
// on). The migration's hand-written half adds the CHECKs and the append-only triggers; `prisma migrate diff` in CI
// asserts this file and the migrations agree.

enum NodeKind {
  POST
  COMMENT
}

/// Mirrors src/tree Status. visible | deleted (author) | removed (moderator), D-13.
enum NodeStatus {
  visible
  deleted
  removed
}

/// Mirrors src/votes Outcome (UNKNOWN_NODE cannot reach a row: the writer refuses it first).
enum VoteOutcome {
  APPLIED
  TOGGLED_OFF
  SWITCHED
  SELF_VOTE
  GATED_DOWNVOTE
}

/// One forum = one org (D-18). A Profile is a user's identity inside one forum: the handle, the account age the
/// gates read (L-1, L-2), and the ban. Fixture users become Profiles over template Users on example.com (D-1).
model Profile {
  id          String        @id @default(uuid()) @db.Uuid
  orgId       String        @db.Uuid
  org         Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId      String        @db.Uuid
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  handle      String
  joinedAt    DateTime      @default(now()) @db.Timestamptz(6)
  bannedUntil DateTime?     @db.Timestamptz(6)
  isModerator Boolean       @default(false)
  modState    String        @default("ACTIVE")
  posts       Post[]
  comments    Comment[]
  votes       Vote[]
  voteEvents  VoteEvent[]
  edits       EditHistory[]
  limitHits   LimitHit[]
  reports     Report[]
  modActions  ModerationAction[] @relation("ModerationActor")
  modSubject  ModerationAction[] @relation("ModerationSubject")
  uploads     Upload[]

  @@unique([orgId, userId])
  @@unique([orgId, handle])
}

model Board {
  id    String @id @default(uuid()) @db.Uuid
  orgId String @db.Uuid
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  slug  String
  title String
  posts Post[]

  @@unique([orgId, slug])
}

/// ups/downs/commentCount are caches; Vote rows and Comment rows are truth (votes:verify, non-negotiable 3).
/// ups starts at 1: the author's fixed +1 (D-12) is written as a Vote row at creation.
model Post {
  id           String     @id @default(uuid()) @db.Uuid
  orgId        String     @db.Uuid
  org          Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  boardId      String     @db.Uuid
  board        Board      @relation(fields: [boardId], references: [id], onDelete: Restrict)
  authorId     String     @db.Uuid
  author       Profile    @relation(fields: [authorId], references: [id], onDelete: Restrict)
  publicId     String
  title        String
  body         String
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)
  editedAt     DateTime?  @db.Timestamptz(6)
  status       NodeStatus @default(visible)
  ups          Int        @default(1)
  downs        Int        @default(0)
  commentCount Int        @default(0)
  lockedAt     DateTime?  @db.Timestamptz(6)
  pinnedAt     DateTime?  @db.Timestamptz(6)
  bodyHash     String?
  comments     Comment[]
  uploads      Upload[]

  @@unique([orgId, publicId])
  @@index([boardId, createdAt])
  @@index([orgId, bodyHash, createdAt])
}

/// path = one 6-char base-36 segment per comment ancestor including itself; depth = segments − 1 (ADR-001). The
/// column is COLLATE "C" (hand-written half, D-34), so the (postId, path) unique btree serves `LIKE prefix || '%'`
/// and `ORDER BY path` in byte order without an operator class Prisma cannot round-trip.
/// Written only by src/forum/tree-write.ts (non-negotiable 2, D-33).
model Comment {
  id        String     @id @default(uuid()) @db.Uuid
  orgId     String     @db.Uuid
  org       Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  postId    String     @db.Uuid
  post      Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  parentId  String?    @db.Uuid
  parent    Comment?   @relation("CommentTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Comment[]  @relation("CommentTree")
  authorId  String     @db.Uuid
  author    Profile    @relation(fields: [authorId], references: [id], onDelete: Restrict)
  publicId  String
  path      String
  depth     Int
  body      String
  createdAt DateTime   @default(now()) @db.Timestamptz(6)
  editedAt  DateTime?  @db.Timestamptz(6)
  status    NodeStatus @default(visible)
  ups       Int        @default(1)
  downs     Int        @default(0)
  bodyHash  String?

  @@unique([orgId, publicId])
  @@unique([postId, path])
  @@index([orgId, bodyHash, createdAt])
}

/// The current vote: one row per voter and node (D-29); absent means no vote (a toggle-off deletes the row).
/// value is +1 or −1 (CHECK in the migration). nodeId points at a Post or a Comment by nodeKind.
model Vote {
  id       String   @id @default(uuid()) @db.Uuid
  orgId    String   @db.Uuid
  org      Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  voterId  String   @db.Uuid
  voter    Profile  @relation(fields: [voterId], references: [id], onDelete: Cascade)
  nodeKind NodeKind
  nodeId   String   @db.Uuid
  value    Int
  castAt   DateTime @db.Timestamptz(6)

  @@unique([voterId, nodeKind, nodeId])
  @@index([nodeKind, nodeId])
}

/// Append-only (trigger): every vote attempt with its outcome (V-1..V-4). The author's creation +1 is not an event.
model VoteEvent {
  id       String      @id @default(uuid()) @db.Uuid
  orgId    String      @db.Uuid
  org      Org         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  voterId  String      @db.Uuid
  voter    Profile     @relation(fields: [voterId], references: [id], onDelete: Cascade)
  nodeKind NodeKind
  nodeId   String      @db.Uuid
  value    Int
  castAt   DateTime    @db.Timestamptz(6)
  outcome  VoteOutcome
  note     String      @default("")

  @@index([nodeKind, nodeId, castAt])
  @@index([orgId, castAt])
}

/// D-31: ≥ 5 GATED_DOWNVOTE events on one node within 600 s → one row per node per window. Recorded, never acted on.
model BrigadeSignal {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @db.Uuid
  org         Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  nodeKind    NodeKind
  nodeId      String   @db.Uuid
  windowStart DateTime @db.Timestamptz(6)
  voterCount  Int
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  reviewedAt  DateTime? @db.Timestamptz(6)

  @@unique([nodeKind, nodeId, windowStart])
}

/// Append-only (trigger): the body as it was before each edit (P0-6, task 2.7).
model EditHistory {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @db.Uuid
  org          Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  nodeKind     NodeKind
  nodeId       String   @db.Uuid
  editorId     String   @db.Uuid
  editor       Profile  @relation(fields: [editorId], references: [id], onDelete: Restrict)
  previousBody String
  editedAt     DateTime @db.Timestamptz(6)
  withinWindow Boolean

  @@index([nodeKind, nodeId, editedAt])
}

/// The ranking cache (R-5): one row per node, replaced by rank:recompute; rankedAt is the freshness pages show.
model RankSnapshot {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  nodeKind  NodeKind
  nodeId    String   @db.Uuid
  rankedAt  DateTime @db.Timestamptz(6)
  hot       Float
  best      Float
  net       Int
  ups       Int
  downs     Int
  createdAt DateTime @db.Timestamptz(6)

  @@unique([nodeKind, nodeId])
  @@index([orgId, nodeKind, hot])
}

/// D-39 / L-3: one row per ALLOWED action, the sliding window's history. Refused attempts are not rows (they are not
/// counted, L-3). Swept by cron past the longest window. The pure engine reads `at`s from here and decides.
model LimitHit {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  profileId String   @db.Uuid
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  action    String
  at        DateTime @db.Timestamptz(6)

  @@index([profileId, action, at])
  @@index([at])
}

/// Phase 4 (task 4.1). A report by a profile on a node, with a reason from rules/moderation.json (closed set, CHECK
/// in the migration). One report per reporter per node.
model Report {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String   @db.Uuid
  org        Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  reporterId String   @db.Uuid
  reporter   Profile  @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  nodeKind   NodeKind
  nodeId     String   @db.Uuid
  reason     String
  detail     String   @default("")
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  @@unique([reporterId, nodeKind, nodeId])
  @@index([nodeKind, nodeId])
}

/// The content state machine (rules/moderation.json content_states): one case per node, opened by the first report
/// or by a signal; state moves only through ModerationAction rows.
model ModerationCase {
  id         String    @id @default(uuid()) @db.Uuid
  orgId      String    @db.Uuid
  org        Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  nodeKind   NodeKind
  nodeId     String    @db.Uuid
  state      String    @default("OPEN")
  openedAt   DateTime  @default(now()) @db.Timestamptz(6)
  resolvedAt DateTime? @db.Timestamptz(6)

  @@unique([nodeKind, nodeId])
  @@index([orgId, state, openedAt])
}

/// Append-only (trigger): every moderator action, on content or on a user, with actor, reason and the transition.
model ModerationAction {
  id              String   @id @default(uuid()) @db.Uuid
  orgId           String   @db.Uuid
  org             Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actorId         String   @db.Uuid
  actor           Profile  @relation("ModerationActor", fields: [actorId], references: [id], onDelete: Restrict)
  kind            String
  nodeKind        NodeKind?
  nodeId          String?  @db.Uuid
  subjectId       String?  @db.Uuid
  subject         Profile? @relation("ModerationSubject", fields: [subjectId], references: [id], onDelete: Restrict)
  fromState       String
  toState         String
  reason          String
  until           DateTime? @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  @@index([orgId, createdAt])
  @@index([nodeKind, nodeId])
  @@index([subjectId])
}

/// Task 4.5: a near-duplicate body inside the window; accepted, queued, never acted on automatically.
model DuplicateSignal {
  id          String    @id @default(uuid()) @db.Uuid
  orgId       String    @db.Uuid
  org         Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  nodeKind    NodeKind
  nodeId      String    @db.Uuid
  matchKind   NodeKind
  matchId     String    @db.Uuid
  bodyHash    String
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  reviewedAt  DateTime? @db.Timestamptz(6)

  @@index([orgId, reviewedAt, createdAt])
  @@index([orgId, bodyHash, createdAt])
}

/// Task 4.7 (from D-40): an attachment on a post. Bytes live outside the database (local disk in dev); only the
/// record is here. Type and size are checked against rules/limits.json before anything is written.
model Upload {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  profileId String   @db.Uuid
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  postId    String?  @db.Uuid
  post      Post?    @relation(fields: [postId], references: [id], onDelete: SetNull)
  mime      String
  bytes     Int
  sha256    String
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([postId])
}
