{
  "name": "saas-foundation",
  "private": true,
  "type": "module",
  "scripts": {
    "preflight": "if [ -x \"$HOME/.claude/bin/swapcheck\" ]; then \"$HOME/.claude/bin/swapcheck\" --quiet; fi",
    "predev": "npm run preflight",
    "dev": "next dev -p __PORT__",
    "predev:template": "npm run preflight",
    "dev:template": "next dev -p 4100",
    "build": "next build",
    "start": "next start -p __PORT__",
    "postinstall": "prisma generate",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "next": "^16.3.6",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "^8",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "dotenv": "^17",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.6",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6",
    "vitest": "^2.1"
  }
}
