{
  "version": 1,
  "young_account": { "max_age_hours": 24, "max_contributions": 5 },
  "downvote_gate": { "min_age_hours": 24, "min_contributions": 3 },
  "windows": [
    { "action": "post",    "per_seconds": 3600, "max": 5,  "young_max": 1 },
    { "action": "comment", "per_seconds": 60,   "max": 6,  "young_max": 2 },
    { "action": "vote",    "per_seconds": 60,   "max": 30, "young_max": 10 },
    { "action": "report",  "per_seconds": 86400, "max": 20, "young_max": 5 },
    { "action": "upload",  "per_seconds": 3600, "max": 10, "young_max": 2 }
  ],
  "edit_window_seconds": 900,
  "max_depth_rendered": 6,
  "upload": { "max_bytes": 2000000, "max_pixels": 25000000, "max_per_post": 4, "types": ["image/png", "image/jpeg", "image/webp"] },
  "signals": {
    "brigade": { "min_voters": 5, "window_seconds": 600 },
    "ring": { "min_voters": 6, "window_seconds": 600 },
    "aged_brigade": { "min_voters": 5, "window_seconds": 600, "max_account_age_days": 7 }
  }
}
